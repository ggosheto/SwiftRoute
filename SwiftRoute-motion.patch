diff --git a/frontend/src/ui/navigationMotion.css b/frontend/src/ui/navigationMotion.css
new file mode 100644
index 0000000..f11e36f
--- /dev/null
+++ b/frontend/src/ui/navigationMotion.css
@@ -0,0 +1,29 @@
+/* Only animate deliberate navigation; loading data must not start a transition. */
+:root[data-sr-motion] { --sr-in-x: 34px; --sr-out-x: -18px; }
+:root[data-sr-motion][data-sr-direction="back"] { --sr-in-x: -34px; --sr-out-x: 18px; }
+:root[data-sr-motion="tab"] { view-transition-name: none; }
+:root[data-sr-motion="tab"] .workspace .shell { view-transition-name: sr-panel; }
+:root[data-sr-motion="page"]::view-transition-old(root),
+:root[data-sr-motion="tab"]::view-transition-old(sr-panel) {
+  animation: sr-leave 180ms ease-in both;
+}
+:root[data-sr-motion="page"]::view-transition-new(root),
+:root[data-sr-motion="tab"]::view-transition-new(sr-panel) {
+  animation: sr-arrive 320ms cubic-bezier(.2,.75,.22,1) both;
+}
+@keyframes sr-leave { to { opacity: 0; transform: translateX(var(--sr-out-x)); } }
+@keyframes sr-arrive { from { opacity: 0; transform: translateX(var(--sr-in-x)); } }
+
+/* White illustration from the original badge, with a single readable wordmark. */
+.sr-brand.sr-signature { gap: 6px; color: white; line-height: 1; letter-spacing: -.055em; }
+.sr-signature .sr-bird { display: block; flex: none; width: 49px; height: 49px; overflow: visible; }
+.sr-signature .sr-word { display: inline-flex; align-items: baseline; }
+.sr-word b { font-weight: inherit; color: #639CC5; }
+.sr-word::after { content: ""; width: 5px; height: 5px; background: #EB2F33; margin-left: 3px; }
+@media (max-width: 720px) {
+  .sr-signature .sr-bird { width: 40px; height: 40px; }
+}
+@media (prefers-reduced-motion: no-preference) {
+  .sr-bird { transition: transform 240ms cubic-bezier(.2,.75,.22,1); }
+  a:is(:hover,:focus-visible) .sr-bird { transform: translate(2px,-2px) rotate(-3deg); }
+}
diff --git a/frontend/src/ui/navigationMotion.ts b/frontend/src/ui/navigationMotion.ts
new file mode 100644
index 0000000..25a95ff
--- /dev/null
+++ b/frontend/src/ui/navigationMotion.ts
@@ -0,0 +1,41 @@
+import { flushSync } from "react-dom";
+import "./navigationMotion.css";
+
+type Scope = "page" | "tab";
+type Running = { finished: Promise<void>; skipTransition(): void };
+let sequence = 0;
+let running: Running | undefined;
+
+export function navigateWithMotion(scope: Scope, forward: boolean, change: () => void) {
+  const id = ++sequence;
+  running?.skipTransition();
+  const root = document.documentElement;
+  const commit = () => { if (id === sequence) flushSync(change); };
+  const clear = () => {
+    if (id === sequence) {
+      delete root.dataset.srMotion;
+      delete root.dataset.srDirection;
+      running = undefined;
+    }
+  };
+  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
+    commit();
+    clear();
+    return;
+  }
+  root.dataset.srMotion = scope;
+  root.dataset.srDirection = forward ? "next" : "back";
+  if (typeof document.startViewTransition === "function") {
+    running = document.startViewTransition(commit);
+    void running.finished.then(clear, clear);
+  } else {
+    commit();
+    const element = document.querySelector(scope === "page" ? "#root" : ".workspace .shell");
+    element?.animate?.(
+      [{ opacity: 0.35, translate: (forward ? 18 : -18) + "px 0" },
+       { opacity: 1, translate: "0 0" }],
+      { duration: 240, easing: "ease-out" }
+    );
+    clear();
+  }
+}
